# Copy to .env for local API development outside Docker.
# Docker Compose injects these itself; see docker-compose.yml.

DATABASE_URL=postgresql://aquageno:aquageno@localhost:5433/aquageno

# Use long random strings in any shared environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8090
COOKIE_SECURE=false
APP_URL=http://localhost:8090
BUSINESS_TZ=Asia/Kolkata
LOG_LEVEL=info
